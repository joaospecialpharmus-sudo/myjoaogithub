# Use the hostname people open in their browser, without scheme or path.
SITE_HOST=ninho.example.com
ALLOWED_HOSTS=ninho.example.com

# TURN credentials are generated by the server, never put TURN_SECRET in the browser.
# Set a random secret and your TURN service URLs to enable TURN. Empty uses STUN only.
TURN_SECRET=
TURN_URLS=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Optional extra STUN URLs separated by commas.
STUN_URLS=
PORT=3000
NODE_ENV=production
